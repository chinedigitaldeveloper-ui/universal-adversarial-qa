{
  "version": 2,
  "name": "javascript-typescript",
  "required_categories": [
    "test",
    "lint"
  ],
  "ai_review": {
    "mode": "advisory",
    "escalate_at": "major"
  },
  "checks": [
    {
      "name": "eslint",
      "category": "lint",
      "argv": [
        "npm",
        "run",
        "lint"
      ],
      "timeout_seconds": 300
    },
    {
      "name": "typecheck",
      "category": "types",
      "argv": [
        "npm",
        "run",
        "typecheck"
      ],
      "timeout_seconds": 300
    },
    {
      "name": "test",
      "category": "test",
      "argv": [
        "npm",
        "test",
        "--",
        "--run"
      ],
      "timeout_seconds": 900
    },
    {
      "name": "build",
      "category": "build",
      "argv": [
        "npm",
        "run",
        "build"
      ],
      "timeout_seconds": 900
    },
    {
      "name": "npm-audit",
      "category": "deps",
      "argv": [
        "npm",
        "audit",
        "--audit-level=high"
      ],
      "timeout_seconds": 300,
      "required": false,
      "exit_codes": {
        "pass": [
          0
        ],
        "fail": [
          1
        ]
      }
    },
    {
      "name": "semgrep",
      "category": "sast",
      "argv": [
        "semgrep",
        "scan",
        "--config",
        "p/default",
        "--error",
        "--metrics",
        "off",
        "--quiet"
      ],
      "timeout_seconds": 900,
      "required": false,
      "exit_codes": {
        "pass": [
          0
        ],
        "fail": [
          1
        ]
      }
    },
    {
      "name": "gitleaks",
      "category": "secrets",
      "argv": [
        "gitleaks",
        "detect",
        "--source",
        ".",
        "--redact",
        "--no-banner",
        "--log-opts={base}..HEAD"
      ],
      "timeout_seconds": 300,
      "required": false,
      "exit_codes": {
        "pass": [
          0
        ],
        "fail": [
          1
        ]
      }
    }
  ]
}
